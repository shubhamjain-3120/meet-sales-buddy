# The full key stays here, never in the extension or invite.
ABLY_API_KEY=appId.keyId:secret
# Generate different random values: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SETUP_KEY=replace-with-a-different-random-secret-of-at-least-24-characters
# Add your returned public Worker URL after deployment.
TOKEN_SERVICE_URL=https://meet-sales-buddy-tokens.your-subdomain.workers.dev
AUTH_PORT=8787
